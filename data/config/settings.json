{
	# Piracy Reworked - fallback values when LunaLib is not enabled

	# Master switch. Off = the war chest economy freezes (bases keep running).
	"piratepat_enabled": true,

	# --- War chest economy ---
	# Bases are priced by TIER: baseCost is a tier-2 base, and each tier up or
	# down multiplies by tierCostGrowth (tier 1 ~94k, 2 = 150k, 3 ~240k,
	# 4 ~384k, 5 ~614k at defaults). The pirates decide what to buy by
	# circumstance: below recoveryBases operating bases they rebuild their
	# footing - best tier affordable while reserving enough for another
	# starter; at or above it they save toward a base one tier above their
	# current best. Builds chain as fast as ~10-day checks allow when flush.
	"piratepat_baseCost": 150000,
	"piratepat_tierCostGrowth": 1.6,
	"piratepat_recoveryBases": 2,

	# After a base is destroyed the pirates pause before rebuilding. The pause
	# scales with wealth: a flush underworld regroups fast (their money is the
	# threat), a broke one stays suppressed. Bounds in months; applied live, so
	# refilling the chest also shortens an existing pause.
	"piratepat_rebuildFreezeMinMonths": 1,
	"piratepat_rebuildFreezeMaxMonths": 12,

	# Passive income per operating base per month. Tuned to ~90% of what an
	# average raid costs over an average raid interval, so bases sustain their
	# vanilla raid cadence but passive income alone never buys a new base.
	"piratepat_incomePerBasePerMonth": 2000,

	# Raids: launch cost per fleet point (tier-1 raid ~100 FP, tier-5 ~450 FP),
	# and returns on success (a fraction of the cost recouped as spoils, plus
	# a cut per size point of the raided system's hostile markets).
	"piratepat_raidCostPerFP": 100,
	"piratepat_raidReturnCostFraction": 0.5,
	"piratepat_raidReturnPerMarketSize": 2000,

	# Starting conditions: the chest is seeded to fund this many bases (minus
	# any that already exist in the save) plus an operating reserve.
	"piratepat_seedBases": 2,
	"piratepat_seedReserve": 30000,

	# Hard cap on simultaneously operating (raiding) pirate bases.
	"piratepat_maxBases": 8,

	# Destroying a pirate base offsets your lifetime contribution figure by
	# this much (never below zero) - the infrastructure your money built is
	# ash, and the sector's ledger against you lightens. Also pulls your
	# income share down, helping restore a pierced Piracy Respite.
	"piratepat_baseKillContributionOffset": 150000,
	# destroying ordinary pirate fleets also offsets your contribution, at
	# this many credits per fleet point destroyed (fleet wiped out in a
	# battle you fought in)
	"piratepat_offsetPerPirateFPDestroyed": 300,

	# --- Shipping plunder ---
	# Pirates preying on trade shipping is plunder, and plunder flows to the
	# war chest. Every colony sector-wide is polled for shipping disruptions;
	# the share attributable to pirates (by local pirate strength, or fully
	# if the system carries a pirate-activity condition from a base) is
	# credited to the chest at this rate per point of the raided colony's
	# size. Chest income only - never counts against your contribution.
	"piratepat_plunderEnabled": true,
	"piratepat_plunderPerDisruptionPerSize": 600,

	# --- Black market contribution weights ---
	# Sales are valued at actual (demand-adjusted) credits, then weighted by
	# what the goods are worth to a pirate war effort. Purchases are plain
	# revenue. Opposing buys/sells of the same goods at the same submarket are
	# netted against each other, so wash-trading contributes nothing.
	"piratepat_buyWeight": 1.0,
	"piratepat_weaponWeight": 3.0,
	"piratepat_shipWeight": 2.0,
	"piratepat_commodityWeight": 1.0,
	"piratepat_oreWeight": 0.5,
	# Flat bonus when a blueprint is sold on the black market (on top of the
	# vanilla behavior of pirates learning it).
	"piratepat_blueprintBonus": 25000,

	# --- Base garrison ---
	# A defensive fleet stationed on each base, so a solo assault faces a real
	# battle group and not a bare station. Strength scales with tier (FP =
	# base + perTier x tier ordinal, so tier 1 ~40 up to tier 5 ~260). Built
	# with standard pirate generation, so it uses the pirates' roster
	# including any blueprints you've sold them. Re-forms this many days after
	# being destroyed if the base still stands; despawns with the base.
	"piratepat_garrisonEnabled": true,
	"piratepat_garrisonFPBase": 40,
	"piratepat_garrisonFPPerTier": 55,
	"piratepat_garrisonRespawnDays": 30,

	# --- Base defenses ---
	# Scale base defense fleets with base tier (vanilla stations get restored
	# with tier, but defenders stay 2 light + 1 medium patrol forever).
	# Tier 3: +1 medium patrol. Tier 4: +1 medium +1 heavy. Tier 5: +2 medium
	# +2 heavy. Patrol fleet size scales linearly up to the max multiplier at
	# tier 5.
	"piratepat_defenseScaling": true,
	"piratepat_defenseFleetSizeMax": 2.0,

	# --- Respite piercing ---
	# Piracy Respite ("pirates are wary of attacking you") is vanilla's
	# permanent reward for defeating the pirate colony crisis. Wariness fades
	# when the war chest overflows with YOUR money: once your lifetime
	# contribution and your share of the underworld's income both exceed these
	# thresholds, bases funded by the chest resume preying on your colonies
	# (pirate activity condition: accessibility/stability drain and ambient
	# fleets - never raids). Your share dilutes over time if you stop
	# contributing, so laying off eventually restores the respite.
	"piratepat_respitePiercing": true,
	"piratepat_pierceMinContribution": 500000,
	"piratepat_pierceMinShare": 0.25,

	# --- Personal bounties ---
	# Each faction whose markets you smuggle through tracks the value you fed
	# to the pirates there and posts a PERSONAL bounty on your head equal to
	# it. No faction-level consequences - you're one ship captain, possibly
	# operating transponder-off; they can't prove enough for a war, but the
	# underworld talks, and money finds hunters. Independent bounty hunter
	# fleets ambush you with strength scaled to the bounty; past the per-fleet
	# cap, multiple fleets hunt concurrently. Bounties decay slowly if you
	# stop adding to them.
	"piratepat_bountyEnabled": true,
	# Bounty only accrues when the market's smuggling suspicion implicates
	# you (the same suspicion level shown in the black market tooltip -
	# transponder-off trading generates none). Below the floor nothing
	# accrues; the attributed fraction scales linearly to 100% at the "full"
	# level (0.3 = "high" suspicion).
	"piratepat_bountySuspicionFloor": 0.05,
	"piratepat_bountySuspicionFull": 0.3,
	# a faction's bounty must exceed this before hunters take the contract
	"piratepat_bountyActivationMin": 50000,
	# hunter fleet strength: 1 fleet point per this many bounty credits
	"piratepat_bountyCreditsPerFP": 1000,
	"piratepat_bountyMaxFPPerFleet": 200,
	# each additional concurrent fleet per this much bounty, up to the cap
	"piratepat_bountyCreditsPerExtraFleet": 250000,
	"piratepat_bountyMaxFleetsPerFaction": 3,
	# spawn roll: every ~10 days per faction with an active bounty and a free
	# hunter slot
	"piratepat_bountySpawnProb": 0.33,
	# monthly interest on each standing bounty - it compounds upward while
	# unpaid (positive = grow, negative = decay/forget, 0 = static)
	"piratepat_bountyGrowthPerMonth": 0.02,
	# hunters weigh the job against your CURRENT fleet: they only take the
	# contract if the fleet the bounty can fund is at least this fraction as
	# strong as your deployed fleet. A huge endgame fleet shrugs off a small
	# bounty; dock most of it for a stealth run and the same bounty is suddenly
	# worth collecting. 0 = always hunt when activated (ignore your strength).
	"piratepat_bountyWorthItFraction": 0.4,
	# defeating a hunter fleet raises that faction's bounty - killing their
	# hunters makes you more notorious, not less. Added as a flat amount plus
	# a fraction of the standing bounty.
	"piratepat_bountyPerKillFlat": 15000,
	"piratepat_bountyPerKillFraction": 0.1,
	# reputation points gained with the pirates each time you destroy a
	# hunter fleet (they appreciate their patron dealing with the opposition);
	# capped so hunter-farming alone can't take you past friendly
	"piratepat_pirateRepPerHunterKill": 2,
	# paying off a bounty at any of that faction's markets costs this
	# multiple of the bounty (a premium over the raw figure - you're buying
	# silence, not settling a debt)
	"piratepat_bountyPayoffMult": 1.25,

	# --- Intel ---
	"piratepat_intelShowExact": true,

	# Debug
	"piratepat_debugLogging": false,
}
